<Window x:Class="BWG_WasteScraper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BWG Waste Scraper v1.0.6 - เข้าสู่ระบบ" Height="700" Width="460"
        Background="#FFF8F5" WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        FontFamily="Leelawadee UI, Segoe UI, Tahoma" FontSize="14"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>

        <!-- ===== Color Palette (เข้มขึ้น อ่านชัด) ===== -->
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderSoft" Color="#E9C6D3"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#D6537F"/>
        <SolidColorBrush x:Key="PrimaryHover" Color="#C03F6B"/>
        <SolidColorBrush x:Key="PrimaryPressed" Color="#A82F58"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#6F5BA8"/>
        <SolidColorBrush x:Key="TextMain" Color="#2E2229"/>
        <SolidColorBrush x:Key="TextMuted" Color="#6B5A64"/>
        <SolidColorBrush x:Key="InputBg" Color="#FFF3F6"/>
        <SolidColorBrush x:Key="InputBgHover" Color="#FFE9F0"/>

        <DropShadowEffect x:Key="SoftShadow" Color="#D6537F" Opacity="0.14"
                          BlurRadius="24" ShadowDepth="4" Direction="270"/>

        <!-- ===== TextBox ===== -->
        <Style x:Key="SoftTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CaretBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource InputBgHover}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== PasswordBox ===== -->
        <Style x:Key="SoftPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CaretBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource InputBgHover}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Option Card (RadioButton แบบการ์ด) ===== -->
        <Style x:Key="OptionCard" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="White"
                                BorderBrush="{StaticResource BorderSoft}" BorderThickness="2"
                                CornerRadius="14" Padding="14,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,14,0">
                                    <Ellipse x:Name="Ring" Stroke="#9C8892" StrokeThickness="2"/>
                                    <Ellipse x:Name="Dot" Width="11" Height="11"
                                             Fill="{StaticResource PrimaryBrush}" Visibility="Collapsed"/>
                                </Grid>

                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFF8FA"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#E58AAB"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFEEF3"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="Ring" Property="Stroke" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Primary Button ===== -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="24" Effect="{StaticResource SoftShadow}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#E8D5DC"/>
                                <Setter Property="Foreground" Value="#8F7A85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border Margin="24" Padding="30,28" Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
            CornerRadius="22" VerticalAlignment="Center"
            Effect="{StaticResource SoftShadow}">
        <StackPanel>

            <!-- Header -->
            <TextBlock Text="🌸 BWG LOGIN" FontSize="26" FontWeight="Bold"
                       Foreground="{StaticResource PrimaryBrush}"
                       HorizontalAlignment="Center" Margin="0,0,0,0"/>
            <TextBlock Text="ยืนยันตัวตนผ่านฐานข้อมูลระบบ" FontSize="14"
                       Foreground="{StaticResource TextMuted}"
                       HorizontalAlignment="Center" Margin="0,6,0,24"/>

            <!-- Username -->
            <TextBlock Text="USERNAME" FontSize="13" FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}" Margin="4,0,0,6"/>
            <TextBox x:Name="TxtUsername" Style="{StaticResource SoftTextBox}" Margin="0,0,0,16"/>

            <!-- Password -->
            <TextBlock Text="PASSWORD" FontSize="13" FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}" Margin="4,0,0,6"/>
            <PasswordBox x:Name="TxtPassword" Style="{StaticResource SoftPasswordBox}" Margin="0,0,0,22"/>

            <!-- เลือกระบบ -->
            <TextBlock Text="เลือกระบบที่ต้องการเปิดหลังเข้าสู่ระบบ" FontSize="13" FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}" Margin="4,0,0,8"/>

            <RadioButton x:Name="RbNewSystem" GroupName="SystemChoice" IsChecked="True"
                         Style="{StaticResource OptionCard}">
                <StackPanel>
                    <TextBlock Text="✨ ระบบใหม่" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource TextMain}"/>
                    <TextBlock Text="หน้าจอใหม่ ใช้งานง่าย รองรับฟีเจอร์ล่าสุด" FontSize="12.5"
                               Foreground="{StaticResource TextMuted}" Margin="0,3,0,0"/>
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="RbOldSystem" GroupName="SystemChoice"
                         Style="{StaticResource OptionCard}" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="🗂️ ระบบเก่า" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource TextMain}"/>
                    <TextBlock Text="หน้าจอเดิมที่คุ้นเคย สำหรับงานที่ยังไม่ย้ายระบบ" FontSize="12.5"
                               Foreground="{StaticResource TextMuted}" Margin="0,3,0,0"/>
                </StackPanel>
            </RadioButton>

            <!-- Login Button -->
            <Button x:Name="BtnLoginSubmit" Content="🔓 ตรวจสอบสิทธิ์เข้าใช้งาน"
                    Height="50" FontSize="16" FontWeight="Bold"
                    IsDefault="True"
                    Click="BtnLoginSubmit_Click"
                    Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
    </Border>
</Window>