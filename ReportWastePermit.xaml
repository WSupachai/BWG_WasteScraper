<Window x:Class="BWG_WasteScraper.ReportWastePermit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BWG_WasteScraper"
        mc:Ignorable="d"
        Title="ระบบออกรายงานข้อมูลสิ่งปฏิกูล - BWG" Height="760" Width="1180"
        WindowStartupLocation="CenterScreen" Background="#FFF8F5"
        FontFamily="Leelawadee UI, Segoe UI, Tahoma" FontSize="14"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>

        <!-- ===== Color Palette (เข้ม อ่านชัด) ===== -->
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderSoft" Color="#E9C6D3"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#D6537F"/>
        <SolidColorBrush x:Key="PrimaryHover" Color="#C03F6B"/>
        <SolidColorBrush x:Key="PrimaryPressed" Color="#A82F58"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#6F5BA8"/>
        <SolidColorBrush x:Key="AccentHover" Color="#5E4B96"/>
        <SolidColorBrush x:Key="AccentPressed" Color="#4D3D80"/>
        <SolidColorBrush x:Key="TextMain" Color="#2E2229"/>
        <SolidColorBrush x:Key="TextMuted" Color="#6B5A64"/>
        <SolidColorBrush x:Key="InputBg" Color="#FFF3F6"/>
        <SolidColorBrush x:Key="InputBgHover" Color="#FFE9F0"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#2E8B63"/>

        <DropShadowEffect x:Key="SoftShadow" Color="#D6537F" Opacity="0.12"
                          BlurRadius="18" ShadowDepth="3" Direction="270"/>

        <!-- ===== TextBox ===== -->
        <Style x:Key="SoftTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CaretBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource InputBgHover}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== ComboBoxItem ===== -->
        <Style x:Key="SoftComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="6" Margin="3,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFE3EC"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F9C9D9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== ComboBox ===== -->
        <Style x:Key="SoftComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource SoftComboItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="{StaticResource InputBg}"
                                                BorderBrush="{StaticResource BorderSoft}"
                                                BorderThickness="1.5" CornerRadius="10">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,12,0" Data="M 0 0 L 4 4 L 8 0"
                                                  Stroke="{StaticResource PrimaryBrush}" StrokeThickness="2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource InputBgHover}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="12,0,32,0" VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>

                            <Popup x:Name="PART_Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="White" BorderBrush="{StaticResource BorderSoft}"
                                        BorderThickness="1" CornerRadius="10" Margin="0,4,0,8"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="260" Padding="3"
                                        Effect="{StaticResource SoftShadow}">
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== DatePicker ===== -->
        <Style x:Key="SoftDatePicker" TargetType="DatePicker">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ===== Primary Button (ชมพู) ===== -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="20" Effect="{StaticResource SoftShadow}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#E8D5DC"/>
                                <Setter Property="Foreground" Value="#8F7A85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Accent Button (ม่วง) ===== -->
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="23" Effect="{StaticResource SoftShadow}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#DDD6EA"/>
                                <Setter Property="Foreground" Value="#7D7690"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== DataGrid ===== -->
        <Style x:Key="SoftColumnHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="BorderBrush" Value="#8C7AC0"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SoftCell" TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Padding="10,4" Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#F9C9D9"/>
                    <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SoftRow" TargetType="DataGridRow">
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFE3EC"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="📊 SYSTEM REPORT GENERATOR" Foreground="{StaticResource PrimaryBrush}"
                       FontSize="26" FontWeight="Bold"/>
            <TextBlock
                       Foreground="{StaticResource TextMuted}" FontSize="15" Margin="0,6,0,0"><Run Text="ดึงข้อมูลรายงาน"/><Run Language="th-th" Text=" "/><Run Text="ตามเงื่อนไขคัดกรองตัวเลือกหน้าแรก"/></TextBlock>
            <Separator Background="{StaticResource BorderSoft}" Margin="0,14,0,0"/>
        </StackPanel>

        <!-- ===== Filter Card ===== -->
        <Border Grid.Row="1" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
                CornerRadius="16" Padding="20" Margin="0,0,0,18"
                Effect="{StaticResource SoftShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.6*"/>
                    <ColumnDefinition Width="1.4*"/>
                    <ColumnDefinition Width="1.3*"/>
                    <ColumnDefinition Width="1.3*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="🏢 เลือกบริษัทเป้าหมาย"
                           Foreground="{StaticResource TextMain}" FontSize="13" FontWeight="SemiBold" Margin="6,0,6,6"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="📄 เลขที่คำขอ (ค้นหาบางส่วนได้)"
                           Foreground="{StaticResource TextMain}" FontSize="13" FontWeight="SemiBold" Margin="6,0,6,6"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="🚦 สถานะ"
                           Foreground="{StaticResource TextMain}" FontSize="13" FontWeight="SemiBold" Margin="6,0,6,6"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="📅 ตั้งแต่วันที่ยื่นคำขอ"
                           Foreground="{StaticResource TextMain}" FontSize="13" FontWeight="SemiBold" Margin="6,0,6,6"/>
                <TextBlock Grid.Row="0" Grid.Column="4" Text="📅 ถึงวันที่ยื่นคำขอ"
                           Foreground="{StaticResource TextMain}" FontSize="13" FontWeight="SemiBold" Margin="6,0,6,6"/>

                <ComboBox Grid.Row="1" Grid.Column="0" x:Name="CboCompany" Margin="6,0"
                          Style="{StaticResource SoftComboBox}">
                    <ComboBoxItem Content="-- ทั้งหมด --" Tag="" IsSelected="True"/>
                    <ComboBoxItem Content="บริษัท BWG จำกัด (20190300225401)" Tag="20190300225401"/>
                    <ComboBoxItem Content="บริษัท BWG จำกัด (10190000825494)" Tag="10190000825494"/>
                    <ComboBoxItem Content="บริษัท BWG จำกัด (82170100125618)" Tag="82170100125618"/>
                    <ComboBoxItem Content="บริษัท BWC จำกัด (82170009625627)" Tag="82170009625627"/>
                </ComboBox>

                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtReqNumber" Margin="6,0"
                         Style="{StaticResource SoftTextBox}"/>

                <ComboBox Grid.Row="1" Grid.Column="2" x:Name="CboStatus" Margin="6,0"
                          Style="{StaticResource SoftComboBox}">
                    <ComboBoxItem Content="-- ทั้งหมด --" Tag="" IsSelected="True"/>
                    <ComboBoxItem Content="รอตอบรับ" Tag="รอตอบรับ"/>
                    <ComboBoxItem Content="รอพิจารณา" Tag="รอพิจารณา"/>
                    <ComboBoxItem Content="ไม่ตอบรับ" Tag="ไม่ตอบรับ"/>
                </ComboBox>

                <DatePicker Grid.Row="1" Grid.Column="3" x:Name="DpFrom" Margin="6,0"
                            Style="{StaticResource SoftDatePicker}"/>
                <DatePicker Grid.Row="1" Grid.Column="4" x:Name="DpTo" Margin="6,0"
                            Style="{StaticResource SoftDatePicker}"/>

                <Button Grid.Row="1" Grid.Column="5" x:Name="BtnSearch" Content="🔍 ค้นหา"
                        Width="110" Height="40" Margin="6,0,0,0" FontSize="14" FontWeight="Bold"
                        Click="BtnSearch_Click" Style="{StaticResource PrimaryButton}"/>
            </Grid>
        </Border>

        <!-- ===== DataGrid ===== -->
        <Border Grid.Row="2" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
                CornerRadius="16" Padding="4" Effect="{StaticResource SoftShadow}">
            <DataGrid x:Name="DgPreview"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      Background="Transparent"
                      RowBackground="White"
                      AlternatingRowBackground="#FFF3F6"
                      Foreground="{StaticResource TextMain}"
                      BorderThickness="0"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#F3DDE4"
                      HeadersVisibility="Column"
                      CanUserAddRows="False"
                      RowHeight="38"
                      FontSize="14"
                      SelectionMode="Single"
                      ColumnHeaderStyle="{StaticResource SoftColumnHeader}"
                      CellStyle="{StaticResource SoftCell}"
                      RowStyle="{StaticResource SoftRow}"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="เลขทะเบียนโรงงานผู้ก่อกำเนิด" Binding="{Binding เลขทะเบียนโรงงานผู้ก่อกำเนิด}" Width="200"/>
                    <DataGridTextColumn Header="ชื่อโรงงาน" Binding="{Binding ชื่อโรงงาน}" Width="220"/>
                    <!--<DataGridTextColumn Header="ประกอบกิจการ" Binding="{Binding ประกอบกิจการ}" Width="190"/>
                    <DataGridTextColumn Header="ที่ตั้งโรงงาน" Binding="{Binding ที่ตั้งโรงงาน}" Width="240"/>
                    <DataGridTextColumn Header="ชื่อผู้รับใบอนุญาต" Binding="{Binding ชื่อผู้รับใบอนุญาต}" Width="190"/>-->

                    <DataGridTextColumn Header="วันที่ยื่นขอ" Binding="{Binding วันที่ยื่นขอ, StringFormat=\{0:dd/MM/yyyy\}}" Width="120"/>
                    <DataGridTextColumn Header="ปี" Binding="{Binding ปี}" Width="80"/>
                    <DataGridTextColumn Header="ประเภทคำขอ" Binding="{Binding ประเภทคำขอ}" Width="170"/>
                    <DataGridTextColumn Header="เลขที่คำขอ" Binding="{Binding เลขที่คำขอ}" Width="150"/>
                    <DataGridTextColumn Header="สถานะหลัก" Binding="{Binding สถานะคำขอหลัก}" Width="150"/>

                    <DataGridTextColumn Header="ลำดับย่อย" Binding="{Binding ลำดับย่อย}" Width="100"/>
                    <DataGridTextColumn Header="รหัสประเภทหรือชนิดของเสีย" Binding="{Binding รหัสประเภทหรือชนิดของเสีย}" Width="200"/>
                    <DataGridTextColumn Header="ชื่อของเสีย" Binding="{Binding ชื่อของเสีย}" Width="220"/>
                    <DataGridTextColumn Header="ปริมาณ (ตัน)" Binding="{Binding [ปริมาณ(ตัน)]}" Width="120"/> 
                    <DataGridTextColumn Header="รหัสการจัดการ" Binding="{Binding รหัสการจัดการ}" Width="140"/>
                    <DataGridTextColumn Header="รายละเอียดวิธีการจัดการ" Binding="{Binding รายละเอียดวิธีการจัดการ}" Width="240"/>
                    <DataGridTextColumn Header="เลขทะเบียนโรงงานผู้รับบริการ" Binding="{Binding เลขทะเบียนโรงงานผู้รับบริการ}" Width="210"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ===== Bottom Bar ===== -->
        <Grid Grid.Row="3" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TxtReportStatus" Text="🟢 พร้อมระบุตัวกรองข้อมูลรายงาน..."
                       Foreground="{StaticResource SuccessBrush}" FontSize="15" FontWeight="Bold"
                       VerticalAlignment="Center"/>

            <Button Grid.Column="1" x:Name="BtnExportExcel" Content="📊 ส่งออกรายงานเป็น Excel (.xlsx)"
                    Width="290" Height="48" FontSize="15" FontWeight="Bold"
                    Click="BtnExportExcel_Click" Style="{StaticResource AccentButton}"/>
        </Grid>
    </Grid>
</Window>
