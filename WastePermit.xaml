<Window x:Class="BWG_WasteScraper.WastePermit"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BWG Waste Scraper v1.0.6 - หน้าหลักระบบ" Height="780" Width="940"
        Background="#FFF8F5" WindowStartupLocation="CenterScreen"
        FontFamily="Leelawadee UI, Segoe UI, Tahoma" FontSize="14"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <Window.Resources>

        <!-- ===== Color Palette (เข้มขึ้น อ่านชัด) ===== -->
        <SolidColorBrush x:Key="BgBrush" Color="#FFF8F5"/>
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderSoft" Color="#E9C6D3"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#D6537F"/>
        <SolidColorBrush x:Key="PrimaryHover" Color="#C03F6B"/>
        <SolidColorBrush x:Key="PrimaryPressed" Color="#A82F58"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#6F5BA8"/>
        <SolidColorBrush x:Key="AccentHover" Color="#5E4B96"/>
        <SolidColorBrush x:Key="AccentPressed" Color="#4D3D80"/>
        <SolidColorBrush x:Key="TextMain" Color="#2E2229"/>
        <SolidColorBrush x:Key="TextMuted" Color="#6B5A64"/>
        <SolidColorBrush x:Key="InputBg" Color="#FFF3F6"/>
        <SolidColorBrush x:Key="InputBgHover" Color="#FFE9F0"/>
        <SolidColorBrush x:Key="SuccessBrush" Color="#2E8B63"/>

        <DropShadowEffect x:Key="SoftShadow" Color="#D6537F" Opacity="0.12"
                          BlurRadius="18" ShadowDepth="3" Direction="270"/>

        <!-- ===== TextBox ===== -->
        <Style x:Key="SoftTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CaretBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource InputBgHover}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== PasswordBox ===== -->
        <Style x:Key="SoftPasswordBox" TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="CaretBrush" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource InputBgHover}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="Bd" Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== ComboBoxItem ===== -->
        <Style x:Key="SoftComboItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="6" Margin="3,1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FFE3EC"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F9C9D9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== ComboBox ===== -->
        <Style x:Key="SoftComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource SoftComboItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="{StaticResource InputBg}"
                                                BorderBrush="{StaticResource BorderSoft}"
                                                BorderThickness="1.5" CornerRadius="10">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,12,0" Data="M 0 0 L 4 4 L 8 0"
                                                  Stroke="{StaticResource PrimaryBrush}" StrokeThickness="2"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource InputBgHover}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="12,0,32,0" VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>

                            <Popup x:Name="PART_Popup" Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="White" BorderBrush="{StaticResource BorderSoft}"
                                        BorderThickness="1" CornerRadius="10" Margin="0,4,0,8"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="260" Padding="3"
                                        Effect="{StaticResource SoftShadow}">
                                    <ScrollViewer>
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== DatePicker ===== -->
        <Style x:Key="SoftDatePicker" TargetType="DatePicker">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoft}"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ===== Primary Button (ชมพู) ===== -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="23" Effect="{StaticResource SoftShadow}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimaryPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#E8D5DC"/>
                                <Setter Property="Foreground" Value="#8F7A85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Accent Button (ม่วง) ===== -->
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="23" Effect="{StaticResource SoftShadow}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#DDD6EA"/>
                                <Setter Property="Foreground" Value="#7D7690"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== Header ===== -->
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <Grid>
                <TextBlock Text="🌸 WASTE DATA AUTOMATION" FontSize="26" FontWeight="Bold"
                           Foreground="{StaticResource PrimaryBrush}"/>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="#EDE7F8" CornerRadius="14" Padding="14,6">
                    <TextBlock x:Name="TxtWelcome" Text="ผู้ใช้งานแอป: Admin"
                               Foreground="{StaticResource AccentBrush}" FontSize="13" FontWeight="Bold"/>
                </Border>
            </Grid>
            <TextBlock FontSize="15"
                       Foreground="{StaticResource TextMuted}" Margin="0,6,0,0"><Run Text="ระบบกวาดข้อมูลคำขออัตโนมัติ (เว็บกรมโรงงาน"/><Run Language="th-th" Text="ใหม่"/><Run Text=")"/></TextBlock>
            <Separator Background="{StaticResource BorderSoft}" Margin="0,14,0,0"/>
        </StackPanel>

        <!-- ===== Filter Card ===== -->
        <Border Grid.Row="1" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
                CornerRadius="16" Padding="22" Margin="0,0,0,18"
                Effect="{StaticResource SoftShadow}">
            <StackPanel>
                <TextBlock Text="🔑 TARGET WEBSITE AUTHENTICATION &amp; SCRAPER FILTERS"
                           FontSize="13" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}" Margin="0,0,0,16"/>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,16">
                        <TextBlock Text="Web Username" FontSize="13" Foreground="{StaticResource TextMain}"
                                   Margin="2,0,0,6" FontWeight="SemiBold"/>
                        <TextBox x:Name="TxtWebUsername" Style="{StaticResource SoftTextBox}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,16">
                        <TextBlock Text="Web Password" FontSize="13" Foreground="{StaticResource TextMain}"
                                   Margin="2,0,0,6" FontWeight="SemiBold"/>
                        <PasswordBox x:Name="TxtWebPassword" Style="{StaticResource SoftPasswordBox}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,16"/>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="📅 ตั้งแต่วันที่ยื่นขอ (Date From)" FontSize="13"
                                   Foreground="{StaticResource TextMain}" Margin="2,0,0,6" FontWeight="SemiBold"/>
                        <DatePicker x:Name="DpFrom" Style="{StaticResource SoftDatePicker}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="📅 ถึงวันที่ยื่นขอ (Date To)" FontSize="13"
                                   Foreground="{StaticResource TextMain}" Margin="2,0,0,6" FontWeight="SemiBold"/>
                        <DatePicker x:Name="DpTo" Style="{StaticResource SoftDatePicker}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="2" VerticalAlignment="Bottom">
                        <Border Background="#FFEEF3" BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
                                CornerRadius="10" Padding="12,8" Margin="5,0,0,0">
                            <TextBlock Text="💡 หมายเหตุ: บอทจะข้ามแถวที่ไม่อยู่ในช่วงวันที่ระบุ"
                                       FontSize="12.5" Foreground="{StaticResource TextMuted}"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        <!-- ===== Logs ===== -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="📋 PROCESS LOGS" FontSize="13" FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}" Margin="4,0,0,8"/>
            <Border Grid.Row="1" Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderSoft}" BorderThickness="1"
                    CornerRadius="16" Effect="{StaticResource SoftShadow}">
                <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="TxtLogs" Background="Transparent" Foreground="{StaticResource TextMain}"
                             BorderThickness="0" FontFamily="Consolas, Leelawadee UI" FontSize="13.5"
                             IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Margin="14"/>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ===== Bottom Bar ===== -->
        <Grid Grid.Row="3" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="TxtStatus" Text="🟢 ระบบพร้อมทำงาน..."
                           Foreground="{StaticResource SuccessBrush}" FontSize="15" FontWeight="Bold"/>
            </StackPanel>

            <Button Grid.Column="1" x:Name="BtnStart" Content="🚀 เริ่มกวาดข้อมูลคำขอ"
                    Width="200" Height="48" FontSize="15" FontWeight="Bold"
                    Click="BtnStart_Click" Margin="0,0,12,0"
                    Style="{StaticResource PrimaryButton}"/>

            <Button Grid.Column="2" x:Name="BtnExportExcel" Content="📊 รายงาน"
                    Width="200" Height="48" FontSize="15" FontWeight="Bold"
                    Click="BtnExportExcel_Click"
                    Style="{StaticResource AccentButton}"/>
        </Grid>
    </Grid>
</Window>